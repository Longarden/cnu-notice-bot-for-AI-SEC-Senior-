# 봇 토큰 (BotFather에서 발급). 구독자 명부 암호화 키도 여기서 파생된다.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 발송 대상. 채널은 @채널명, 개인은 숫자 chat_id. 콤마로 여러 개 가능.
TELEGRAM_CHAT_ID=@cnu_alarm

# 봇에게 /start 를 보낸 사람에게 안내할 채널 링크. 비우면 안내를 하지 않는다.
TELEGRAM_CHANNEL_LINK=https://t.me/cnu_alarm

# 봇 토큰을 재발급했을 때, 기존 명부를 계속 읽기 위한 옛 토큰 (선택).
# ROSTER_KEY=

# 1이면 수집만 하고 전송하지 않는다 (파일도 건드리지 않음).
# DRY_RUN=1

# 1이면 /start 응대와 명부 갱신만 하고 공지는 보내지 않는다 (greet.yml 전용).
# GREET_ONLY=1
